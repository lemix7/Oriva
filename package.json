{
  "name": "express-app",
  "version": "1.0.0",
  "description": "demo",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "test:e2e": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/workers/email.worker.js",
    "dev:worker": "tsx watch src/workers/email.worker.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@types/multer": "^2.3.0",
    "@types/multer-s3": "^3.0.3",
    "@vinejs/vine": "^4.4.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "bullmq": "^6.3.17",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "multer-s3": "^3.0.1",
    "pg": "^8.23.1",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
